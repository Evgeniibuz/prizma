# ═══════════════════════════════════════════════════════════════
# PULSΞ — environment variables
# ═══════════════════════════════════════════════════════════════
# For local Docker Compose: copy this to `.env` and fill values.
# For Railway: paste each block into the service's Variables panel.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────
# Set to "production" on Railway. The app fails to start if this is
# "production" AND JWT_SECRET is still the dev default — that's the
# intended guardrail, not a bug.
PULSE_ENV=production
LOG_LEVEL=INFO
# PORT is injected automatically by Railway. Locally we default to 8000.
PORT=8000

# ── Database ───────────────────────────────────────────────────
# On Railway: link the Postgres plugin → DATABASE_URL is auto-injected
# (use the "Reference" picker in the Variables tab, value: ${{Postgres.DATABASE_URL}}).
# Locally with docker-compose, leave DATABASE_URL blank and the compose
# file composes one from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
POSTGRES_DB=pulse_db
POSTGRES_USER=pulse_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Set to "1" only if you've already provisioned the schema another way
# and want to skip the auto-bootstrap step on app start.
# SKIP_DB_BOOTSTRAP=0

# ── Redis ──────────────────────────────────────────────────────
# On Railway: link the Redis plugin → REDIS_URL=${{Redis.REDIS_URL}}.
# If REDIS_URL is unset, rate-limiting falls back to in-process memory,
# which is fine for a single replica.
REDIS_PORT=6379
# REDIS_URL=redis://redis:6379

# ── Auth (REQUIRED in production) ──────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRE_DAYS=7

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated origins for browser CORS. Set to your Railway domain
# (e.g. https://pulse.up.railway.app) plus any custom domain. If blank
# the server allows "*" but disables credentials (spec-compliant).
PULSE_ALLOWED_ORIGINS=

# ── External APIs (all optional — the app degrades gracefully) ──
COINGECKO_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
TWITTER_BEARER_TOKEN=
TWITTER_PROXY=

# ── Sentiment cache TTL (minutes) ──────────────────────────────
CASHTAG_CACHE_TTL_MIN=120

# ── pgAdmin (only used if `docker compose --profile tools up`) ──
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=admin
